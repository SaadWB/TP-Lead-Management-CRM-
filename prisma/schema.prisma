datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TELECALLER
  SALESMAN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  CALL
  FOLLOW_UP
  DEMO
  MEETING
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AssignmentRoleType {
  TELECALLER
  SALESMAN
}

model User {
  id                  String         @id @default(cuid()) @db.VarChar(36)
  name                String         @db.VarChar(100)
  email               String         @unique @db.VarChar(191)
  passwordHash        String         @db.VarChar(255)
  role                Role
  phone               String?        @db.VarChar(30)
  isActive            Boolean        @default(true)
  mustChangePassword  Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relationships
  assignedTelecallerLeads Lead[]                  @relation("TelecallerLeads")
  assignedSalesmanLeads   Lead[]                  @relation("SalesmanLeads")
  createdLeads            Lead[]                  @relation("CreatedLeads")
  activities              LeadActivity[]
  callLogs                CallLog[]
  followUpTasks           FollowUpTask[]
  assignedByHistories     LeadAssignmentHistory[] @relation("AssignedBy")
  previousUserHistories   LeadAssignmentHistory[] @relation("PreviousUser")
  newUserHistories        LeadAssignmentHistory[] @relation("NewUser")
  notifications           Notification[]
  importJobs              ImportJob[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]

  @@index([role, isActive])
  @@index([email])
  @@index([createdAt])
}

model RefreshToken {
  id                  String    @id @default(cuid()) @db.VarChar(36)
  tokenHash           String    @unique @db.VarChar(128)
  userId              String    @db.VarChar(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  replacedByTokenHash String?   @db.VarChar(128)
  ipAddress           String?   @db.VarChar(45)
  userAgent           String?   @db.Text

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Lead {
  id                   String       @id @default(cuid()) @db.VarChar(36)
  companyName          String       @db.VarChar(150)
  serviceProduct       String       @db.VarChar(150)
  contactPerson        String?      @db.VarChar(100)
  phone                String       @db.VarChar(30)
  email                String?      @db.VarChar(100)
  alternatePhone       String?      @db.VarChar(30)
  website              String?      @db.VarChar(255)
  city                 String?      @db.VarChar(100)
  state                String?      @db.VarChar(100)
  priority             Priority     @default(MEDIUM)
  pipelineStage        String       @default("New Lead") @db.VarChar(50)
  salesStage           String?      @db.VarChar(50)
  callAttempts         Int          @default(0)
  isRetry              Boolean      @default(false)
  retryCount           Int          @default(0)
  lastCallOutcome      String?      @db.VarChar(50)
  lastContactDate      DateTime?
  lastStatusUpdatedAt  DateTime?
  nextFollowUpDate     DateTime?
  nextAction           String?      @db.Text
  notes                String?      @db.Text
  
  // Lead Source
  leadSource           String?      @db.VarChar(100)
  leadSourceOther      String?      @db.VarChar(100)
  
  assignedTelecallerId String?      @db.VarChar(36)
  assignedTelecaller   User?        @relation("TelecallerLeads", fields: [assignedTelecallerId], references: [id], onDelete: SetNull)
  
  assignedSalesmanId   String?      @db.VarChar(36)
  assignedSalesman     User?        @relation("SalesmanLeads", fields: [assignedSalesmanId], references: [id], onDelete: SetNull)
  
  createdById          String?      @db.VarChar(36)
  createdBy            User?        @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  lastActivityAt       DateTime?    @default(now())
  convertedAt          DateTime?
  dealValue            Float?
  lostReason           String?      @db.VarChar(100)
  lostNotes            String?      @db.Text
  archivedAt           DateTime?

  // Soft delete fields
  isDeleted            Boolean      @default(false)
  deletedAt            DateTime?
  deletedById          String?      @db.VarChar(36)

  // Relations
  activities           LeadActivity[]
  callLogs             CallLog[]
  followUpTasks        FollowUpTask[]
  assignmentHistories  LeadAssignmentHistory[]
  importRows           ImportRow[]

  @@index([pipelineStage])
  @@index([salesStage])
  @@index([leadSource])
  @@index([assignedTelecallerId])
  @@index([assignedSalesmanId])
  @@index([priority])
  @@index([phone])
  @@index([email])
  @@index([companyName])
  @@index([lastActivityAt])
  @@index([nextFollowUpDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isDeleted])
  @@index([isDeleted, pipelineStage])
  @@index([assignedTelecallerId, pipelineStage])
  @@index([assignedTelecallerId, nextFollowUpDate])
  @@index([assignedSalesmanId, salesStage])
  @@index([pipelineStage, lastCallOutcome])
}

model LeadActivity {
  id          String   @id @default(cuid()) @db.VarChar(36)
  leadId      String   @db.VarChar(36)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?  @db.VarChar(36)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String   @db.VarChar(50)
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([userId])
}

model LeadAssignmentHistory {
  id              String             @id @default(cuid()) @db.VarChar(36)
  leadId          String             @db.VarChar(36)
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedById    String             @db.VarChar(36)
  assignedBy      User               @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  previousUserId  String?            @db.VarChar(36)
  previousUser    User?              @relation("PreviousUser", fields: [previousUserId], references: [id], onDelete: SetNull)
  newUserId       String             @db.VarChar(36)
  newUser         User               @relation("NewUser", fields: [newUserId], references: [id], onDelete: Cascade)
  roleType        AssignmentRoleType
  handoverSummary String?            @db.Text
  createdAt       DateTime           @default(now())

  @@index([leadId, createdAt])
  @@index([newUserId])
}

model CallLog {
  id               String   @id @default(cuid()) @db.VarChar(36)
  leadId           String   @db.VarChar(36)
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String   @db.VarChar(36)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome          String   @db.VarChar(50)
  notes            String   @db.Text
  contactDate      DateTime @default(now())
  followUpNeeded   Boolean  @default(false)
  nextFollowUpDate DateTime?
  nextAction       String?  @db.Text
  durationSeconds  Int?
  createdAt        DateTime @default(now())

  @@index([leadId, contactDate])
  @@index([userId, contactDate])
  @@index([contactDate])
}

model FollowUpTask {
  id             String     @id @default(cuid()) @db.VarChar(36)
  leadId         String     @db.VarChar(36)
  lead           Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUserId String     @db.VarChar(36)
  assignedUser   User       @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)
  taskType       TaskType   @default(FOLLOW_UP)
  dueDate        DateTime
  dueTime        String?    @db.VarChar(20)
  notes          String?    @db.Text
  status         TaskStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([assignedUserId, dueDate, status])
  @@index([leadId])
  @@index([dueDate])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  isRead    Boolean  @default(false)
  link      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model ImportJob {
  id            String      @id @default(cuid()) @db.VarChar(36)
  createdById   String      @db.VarChar(36)
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  fileName      String      @db.VarChar(255)
  totalRows     Int         @default(0)
  validRows     Int         @default(0)
  invalidRows   Int         @default(0)
  duplicateRows Int         @default(0)
  importedRows  Int         @default(0)
  skippedRows   Int         @default(0)
  status        String      @default("COMPLETED") @db.VarChar(50)
  createdAt     DateTime    @default(now())
  rows          ImportRow[]

  @@index([createdById, createdAt])
}

model ImportRow {
  id              String     @id @default(cuid()) @db.VarChar(36)
  importJobId     String     @db.VarChar(36)
  importJob       ImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rawData         Json
  parsedData      Json?
  status          String     @default("PENDING") @db.VarChar(50)
  duplicateReason String?    @db.VarChar(255)
  resolution      String?    @db.VarChar(50)
  leadId          String?    @db.VarChar(36)
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())

  @@index([importJobId])
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(36)
  userId    String?  @db.VarChar(36)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @db.VarChar(36)
  details   Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  status    String   @default("SUCCESS") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model PipelineStageOption {
  id        String   @id @default(cuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(100)
  color     String?  @db.VarChar(50)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model CallOutcomeOption {
  id                     String   @id @default(cuid()) @db.VarChar(36)
  name                   String   @unique @db.VarChar(100)
  color                  String?  @db.VarChar(50)
  suggestedPipelineStage String?  @db.VarChar(50)
  requiresDateTime       Boolean  @default(false)
  requiresNextFollowUp   Boolean  @default(false)
  closesLead             Boolean  @default(false)
  autoReturnNewLeadsDays Int?
  isDefault              Boolean  @default(false)
  isActive               Boolean  @default(true)
  order                  Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive, order])
}

model LeadSourceOption {
  id        String   @id @default(cuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(100)
  color     String?  @db.VarChar(50)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}
