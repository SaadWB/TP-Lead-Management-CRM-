# Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / phpMyAdmin localhost or Cloud MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://crm_user:STRONG_PASSWORD@localhost:3306/tp-lead-management-crm"

# Authentication & Security
# Must be at least 32 characters, randomly generated (e.g. openssl rand -base64 32)
JWT_SECRET="replace-with-a-very-long-and-random-secret-key-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-key-for-refresh-tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:3000"

# Initial Admin Setup (used by prisma/seed.ts on first run)
INITIAL_ADMIN_EMAIL="admin@tenderprocure.com"
INITIAL_ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# Transactional Email (Resend) - Optional
RESEND_API_KEY=""
EMAIL_FROM="TenderProcure CRM <notifications@tenderprocure.com>"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000"
