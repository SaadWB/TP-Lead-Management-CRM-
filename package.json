{
  "name": "tenderprocure-leads-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel --if-present",
    "dev:api": "npm run dev --workspace=@crm/api",
    "dev:web": "npm run dev --workspace=@crm/web",
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:test": "node scripts/testDb.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "sucrase-node prisma/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}