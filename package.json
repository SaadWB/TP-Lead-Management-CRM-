{
  "name": "tenderprocure-leads-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --parallel --if-present",
    "dev:api": "npm run dev --workspace=@crm/api",
    "dev:web": "npm run dev --workspace=@crm/web",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "npm run build --workspace=@crm/shared && prisma generate",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:test": "node scripts/testDb.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "sucrase-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}